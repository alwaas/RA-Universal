# =============================================================================
# RA-UNIVERSAL: ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================

# PostgreSQL Database Connection String (Neon, Supabase, or local PostgreSQL)
DATABASE_URL="postgresql://ra_admin:secret_pass@ep-ancient-lake.ap-southeast-1.neon.tech/ra_store?sslmode=require"

# JWT Encryption Secret (At least 32 characters for AES/HMAC-SHA256 signing)
JWT_SECRET="ra_heritage_weaves_secure_jwt_secret_token_32chars_min"

# Default Admin Seed Credentials (for initial setup)
ADMIN_DEFAULT_PHONE="9999999999"
ADMIN_DEFAULT_PASSWORD="SuperSecureAdminPassword2026!"

# Node Environment
NODE_ENV="development"

# =============================================================================
# PUBLIC EXPOSURES (PREFIXED WITH NEXT_PUBLIC_)
# =============================================================================

# Canonical Site URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# WhatsApp Business Support Number (Indian 10-digit with 91 prefix, no +, no spaces)
NEXT_PUBLIC_WHATSAPP_PHONE="919876543210"

# Brand Name
NEXT_PUBLIC_BRAND_NAME="RA Heritage Weaves"
# =============================================================================
# RA-UNIVERSAL: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Duplicate this file as .env.local for local development.
# 2. In Vercel (or production host), configure these under Project Settings > Environment Variables.
# 3. CRITICAL: Never commit .env.local or sensitive secrets into git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SERVER-ONLY SECRETS (NEVER PREFIX WITH NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# PostgreSQL Connection String (Neon, Supabase, AWS RDS, or Render)
# For serverless hosting (Vercel), always use the pooled connection string (with ?sslmode=require).
# Example: postgresql://ra_user:secure_password@ep-cold-pond-123456.ap-southeast-1.neon.tech/ra_db?sslmode=require
DATABASE_URL="postgresql://ra_admin:replace_with_prod_password@ep-ancient-lake.ap-southeast-1.neon.tech/ra_store?sslmode=require"

# JWT Encryption Secret
# Must be a cryptographically random string (min 32 characters).
# Generate using: openssl rand -base64 32
JWT_SECRET="replace_with_a_cryptographically_secure_256_bit_random_key_min_32_chars"

# Default Administrator Bootstrapping Credentials
# Used for initial access before managing users via database.
ADMIN_DEFAULT_PHONE="9999999999"
ADMIN_DEFAULT_PASSWORD="ReplaceWithSuperSecureAdminPassword2026!"
ADMIN_EMAIL="admin@rauniversal.in"

# Cloudinary Storage (Optional - For direct image asset uploads)
CLOUDINARY_CLOUD_NAME="ra-handloom"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="replace_with_cloudinary_api_secret"

# Runtime Environment
NODE_ENV="production"

# -----------------------------------------------------------------------------
# 2. CLIENT-SAFE EXPOSURES (PREFIXED WITH NEXT_PUBLIC_)
# -----------------------------------------------------------------------------

# Canonical Production Domain URL (Used for metadata, OpenGraph, sitemaps)
NEXT_PUBLIC_APP_URL="https://ra-universal.vercel.app"

# Official WhatsApp Business Desk Number (Indian format: 91 followed by 10 digits, no +, no spaces)
# Example for +91 98765 43210: 919876543210
NEXT_PUBLIC_WHATSAPP_PHONE="919876543210"

# Public Brand Name (Used in UI copy, page metadata, WhatsApp templates)
NEXT_PUBLIC_BRAND_NAME="RA Heritage Weaves"
